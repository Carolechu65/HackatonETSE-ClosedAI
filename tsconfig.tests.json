{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "src/domain/**/*.ts",
    "src/widgets/**/*.ts",
    "src/features/tasks/**/*.ts"
  ],
  "exclude": [
    "src/widgets/publisher.ts",
    "src/widgets/publish.native.ts",
    "src/widgets/**/*.tsx"
  ]
}
