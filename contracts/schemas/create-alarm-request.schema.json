{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alarmat.local/contracts/create-alarm-request.schema.json",
  "title": "createAlarmRequest · payload v1",
  "description": "El emisor propone un aviso a uno o varios miembros activos. Crear una propuesta nunca programa nada en el móvil de nadie.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "recipientUids", "mode", "timeSpec"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "taskId": {
      "$ref": "./common.schema.json#/$defs/identifier"
    },
    "recipientUids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "./common.schema.json#/$defs/uid" }
    },
    "mode": { "$ref": "./common.schema.json#/$defs/mode" },
    "timeSpec": { "$ref": "./common.schema.json#/$defs/timeSpec" },
    "recurrence": { "$ref": "./common.schema.json#/$defs/weeklyRecurrence" }
  }
}
