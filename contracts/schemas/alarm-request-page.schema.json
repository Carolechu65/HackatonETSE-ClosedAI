{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alarmat.local/contracts/alarm-request-page.schema.json",
  "title": "GET /v1/groups/{groupId}/alarm-requests · página v1",
  "description": "Lista paginada limitada al creador o destinatario con membresía activa. El wrapper HTTP aporta paginación; los DTO `request` y `recipient` conservan su esquema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "request"
        ],
        "properties": {
          "requestId": {
            "$ref": "./common.schema.json#/$defs/identifier"
          },
          "request": {
            "$ref": "./alarm-request.schema.json"
          },
          "recipient": {
            "oneOf": [
              {
                "$ref": "./recipient.schema.json"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "nextCursor": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
