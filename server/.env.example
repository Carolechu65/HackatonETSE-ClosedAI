# API alarmaT - configuración del VPS. Copia a .env privado; nunca lo subas a git.
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=/var/lib/alarmat/alarmat.db
SESSION_TTL_MS=604800000
TRUST_PROXY=true
LOG_LEVEL=info

# Límites de ventana fija: auth por IP; mutaciones y agente por cuenta.
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_MS=60000
OPERATION_RATE_LIMIT=120
OPERATION_RATE_WINDOW_MS=60000
AGENT_RATE_LIMIT=10
AGENT_RATE_WINDOW_MS=60000

# Push opcional. Sin EXPO_PUSH_TOKEN la API sigue funcionando y la outbox
# queda pendiente: no se promete entrega con la app cerrada.
EXPO_PUSH_TOKEN=
PUSH_WORKER_ENABLED=false

# Agente. none | deterministic | openai
# deterministic solo para demo/pruebas locales y se etiqueta como tal.
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=15000
AGENT_SESSION_TTL_MS=1800000

# Product integration: explicit browser origins, no wildcard CORS.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8091,http://127.0.0.1:8091
# OpenRouter aliases configure the existing OpenAI-compatible provider.
# Keep the actual key in a private environment file outside the repository.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Google Calendar: OAuth client shared with Lois; user grants remain independent.
# Leave ALL six empty to disable. Never expose these values through EXPO_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALENDAR_ENCRYPTION_KEY=
GOOGLE_REDIRECT_URI=
CALENDAR_PUBLIC_API_URL=
CALENDAR_APP_URL=
