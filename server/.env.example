# API alarmaT - configuración del VPS. Copia a .env privado; nunca lo subas a git.
HOST=0.0.0.0
PORT=8787
DATABASE_PATH=/var/lib/alarmat/alarmat.db
SESSION_TTL_MS=604800000
TRUST_PROXY=true
LOG_LEVEL=info

# Límites básicos (por IP y ventana fija).
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_MS=60000
OPERATION_RATE_LIMIT=120
OPERATION_RATE_WINDOW_MS=60000
AGENT_RATE_LIMIT=10
AGENT_RATE_WINDOW_MS=60000

# Push opcional. Sin EXPO_PUSH_TOKEN la API sigue funcionando y la outbox
# queda pendiente: no se promete entrega con la app cerrada.
EXPO_PUSH_TOKEN=
PUSH_WORKER_ENABLED=false

# Agente. none | deterministic | openai
# deterministic solo para demo/pruebas locales y se etiqueta como tal.
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=15000
AGENT_SESSION_TTL_MS=1800000
