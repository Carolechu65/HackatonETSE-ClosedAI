{
  "name": "alarmat-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server/src/index.js",
    "dev": "node --experimental-transform-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/index.ts",
    "migrate": "node dist/server/src/migrate-cli.js",
    "test": "npm run build && node --test \"dist/server/test/*.test.js\"",
    "backup": "node scripts/backup.mjs",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.20.5",
    "typescript": "~6.0.3"
  }
}
